# Run scripts/Initialize-Environment.ps1 to create a private file and random credentials.
COMPOSE_PROJECT_NAME=helishop-prod
CONTAINER_PREFIX=helishop_prod
FRONTEND_PORT=80
BACKEND_PORT=8080
# Separate from docker-compose.yml development ports.
MYSQL_PORT=13307
REDIS_PORT=16379
RABBITMQ_PORT=15673
RABBITMQ_MANAGEMENT_PORT=15674
MYSQL_DATABASE=eshop_db
MYSQL_USER=eshop_user
MYSQL_PASSWORD=GENERATE
MYSQL_ROOT_PASSWORD=GENERATE
RABBITMQ_USER=helishop
RABBITMQ_PASSWORD=GENERATE
JWT_SECRET=GENERATE
MYSQL_VOLUME_NAME=eshop_prod_mysql_data
REDIS_VOLUME_NAME=eshop_prod_redis_data
RABBITMQ_VOLUME_NAME=eshop_prod_rabbitmq_data
UPLOADS_VOLUME_NAME=helishop_prod_uploads
VITE_API_BASE_URL=/api/v1
CORS_ALLOWED_ORIGINS=http://localhost
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
# Set merchant credentials and public HTTPS callbacks before accepting bank payments.
VNP_DISABLED=true
VNP_TMN_CODE=
VNP_HASH_SECRET=
VNP_RETURN_URL=http://localhost/payment-result
VNP_IPN_URL=http://localhost/api/v1/payments/vnpay-ipn
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
